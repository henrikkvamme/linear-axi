# Repo-local settings. HOME, XDG_CONFIG_HOME, and LINEAR_AXI_ENV_FILE
# are ignored here and must be set in the process environment.

# Choose one:
# LINEAR_API_KEY=lin_api_...
# LINEAR_ACCESS_TOKEN=...

# Optional:
# LINEAR_TEAM=BEN

# Only needed when overriding the built-in public OAuth client:
# LINEAR_OAUTH_CLIENT_ID=your-client-id
LINEAR_OAUTH_REDIRECT_URI=http://127.0.0.1:14582/oauth/callback
LINEAR_OAUTH_SCOPE=read,write
LINEAR_OAUTH_ACTOR=user
