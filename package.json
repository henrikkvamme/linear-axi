{
  "name": "linear-axi",
  "version": "0.1.0",
  "description": "AXI-friendly Linear CLI for agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "linear-axi": "./src/main.ts"
  },
  "files": [
    "src",
    ".agents/skills/linear-axi",
    "assets/linear-axi-banner.png",
    ".env.example",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikkvamme/linear-axi.git"
  },
  "bugs": {
    "url": "https://github.com/henrikkvamme/linear-axi/issues"
  },
  "homepage": "https://github.com/henrikkvamme/linear-axi#readme",
  "keywords": [
    "linear",
    "axi",
    "cli",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-dotenv --outfile dist/linear-axi src/main.ts",
    "check": "bun run parity:check && bun run typecheck && bun run test && bun run build",
    "parity:check": "bun scripts/check-parity.ts",
    "parity:capture": "bun scripts/capture-official-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/*.test.ts"
  },
  "dependencies": {
    "@linear/sdk": "88.0.0",
    "@toon-format/toon": "2.3.0",
    "effect": "4.0.0-beta.94"
  },
  "devDependencies": {
    "@effect/tsgo": "0.16.3",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
